{
  "name": "lembed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "discord cards with real link buttons, self-hosted",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "npm run build && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch server.ts)",
    "start": "node --env-file-if-exists=.env server.ts",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vendor": "node scripts/vendor.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@melloware/coloris": "0.25.2",
    "cheerio": "^1.1.2",
    "codemirror": "5.65.21",
    "emoji-picker-element": "1.29.1",
    "emoji-picker-element-data": "1.8.0",
    "ipaddr.js": "^2.2.0",
    "lucide-static": "1.73.0",
    "markdown-it": "^15.0.3",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "@types/codemirror": "5.60.18",
    "@types/node": "26.6.6",
    "@types/sortablejs": "1.15.9",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
